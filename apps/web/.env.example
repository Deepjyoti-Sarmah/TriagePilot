# Copy to .env.local. All server-only — never import these in client components.
# Empty = app runs in MOCK mode (deterministic demo output, see lib/providers/mock.ts).
# LLM calls happen inside providers (Activepieces agent or direct); see specs/007.
# TRIAGE_PROVIDER=mock|activepieces|openrouter|openai (default: mock w/o keys)
# TRIAGE_MODEL= (defaults per provider; free-first qwen/qwen3.8-27b:free)
AP_API_KEY=
AP_PROJECT_ID=
AP_MCP_URL=
GITHUB_PAT=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
