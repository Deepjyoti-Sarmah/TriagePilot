# Keys — YOU provide later. Never commit real values.
# Copy to .env.local (Vercel env) + Cloud connections.

AP_API_KEY=
AP_PROJECT_ID=
# MCP server (OAuth, browser clients like Claude/Cursor): https://cloud.activepieces.com/mcp
# No static token exists — "No API keys to manage". Programmatic path below instead.
AP_MCP_URL=https://cloud.activepieces.com/mcp
# Backend live-agent path (spec 003): webhook URL of the mcp-maintainer-entry
# flow (returnsResponse:true). Paste after creating the flow in Cloud.
AP_FLOW_WEBHOOK_URL=
# Backend split (spec 008): Next.js forwards to Python when set.
# Local: TRIAGE_API_URL=http://localhost:8000
TRIAGE_API_URL=
# Backend provider: mock | activepieces | openrouter | openai
# default: mock without keys, activepieces when AP_* present.
TRIAGE_PROVIDER=
# Model per provider (defaults: deepseek/deepseek-v4-flash-0731:free, gpt-4o-mini).
TRIAGE_MODEL=
OPENROUTER_API_KEY=
# Free tier is enough: model qwen/qwen3.8-27b:free ($0, 262K ctx).
# Get one at https://openrouter.ai/keys ; add as OpenRouter provider in
# Cloud Platform Admin → AI Center (supported since 0.74.0).
# Optional fallback if the accuracy gate fails: OPENAI_API_KEY= (gpt-4o).
# Optional, only if OpenRouter embeddings fall short for the KB.
GITHUB_PAT=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
